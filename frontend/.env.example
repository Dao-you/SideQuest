# SideQuest Frontend Environment Configuration

# Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=

# Base API URL (defaults to '/api/v1' via Vite proxy to localhost:8080)
VITE_API_BASE_URL=/api/v1

# Data source selection: 'api' (default with CSV fallback) or 'csv' (offline standalone)
VITE_EVENT_SOURCE=api

# Agent source selection: 'agent' (Gemini 3.7 Flash SSE) or 'mock' (offline fallback)
VITE_AGENT_SOURCE=agent
