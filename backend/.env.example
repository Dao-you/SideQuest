# SideQuest Environment Variables
APP_NAME="SideQuest Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8080
HOST="0.0.0.0"

# Google AI Studio / Gemini API Key
# If omitted or left blank, the system automatically runs the High-Fidelity Mock Agent & Simulation Engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Google Maps Platform API Key (Places New, Routes, Solar, Geocoding)
# If omitted or left blank, high-precision Taipei mock datasets and simulation logic are used seamlessly.
GOOGLE_MAPS_API_KEY=""

# Google Cloud Platform Configuration
GCP_PROJECT_ID=""
FIRESTORE_DATABASE="(default)"
FIRESTORE_EMULATOR_HOST=""

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,*"
